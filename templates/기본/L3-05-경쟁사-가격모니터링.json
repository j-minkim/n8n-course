{
  "name": "🔎 경쟁사 가격 모니터링",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "t5a",
      "name": "매일 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "경쟁사URL"
        },
        "options": {}
      },
      "id": "t5b",
      "name": "경쟁사 URL 목록",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json['URL'] }}",
        "options": {}
      },
      "id": "t5c",
      "name": "경쟁사 페이지 요청",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 경쟁사 페이지 HTML에서 가격 추출 (사이트마다 정규식 조정 필요)\nconst html=$json['data']||$json['body']||'';\nconst m=html.match(/([0-9][0-9,]{3,})\\s*원/);\nconst price=m?Number(m[1].replace(/,/g,'')):null;\nconst myPrice=Number($('경쟁사 URL 목록').item.json['자사가격']||0);\nreturn [{json:{경쟁사가격:price, 자사가격:myPrice, 역전:(price!==null&&price<myPrice)}}];"
      },
      "id": "t5d",
      "name": "가격 추출·비교",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json['역전']) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "t5e",
      "name": "가격 역전 시",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_MD@example.com",
        "subject": "=[경쟁사] 가격 역전 감지",
        "emailType": "text",
        "message": "=경쟁사가 더 쌉니다.\n- 경쟁사가격: {{ $json['경쟁사가격'] }}원\n- 자사가격: {{ $json['자사가격'] }}원",
        "options": {}
      },
      "id": "t5f",
      "name": "담당 MD 알림",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1240,
        220
      ]
    }
  ],
  "connections": {
    "매일 09:00": {
      "main": [
        [
          {
            "node": "경쟁사 URL 목록",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "경쟁사 URL 목록": {
      "main": [
        [
          {
            "node": "경쟁사 페이지 요청",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "경쟁사 페이지 요청": {
      "main": [
        [
          {
            "node": "가격 추출·비교",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "가격 추출·비교": {
      "main": [
        [
          {
            "node": "가격 역전 시",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "가격 역전 시": {
      "main": [
        [
          {
            "node": "담당 MD 알림",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
