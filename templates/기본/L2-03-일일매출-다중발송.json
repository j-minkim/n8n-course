    {
      "parameters": {
        "jsCode": "const items=$input.all();\nconst byCat={};\nfor(const it of items){const c=it.json['상품군']||'기타';const rev=Number(String(it.json['매출']||0).replace(/[,\\s]/g,''))||0;byCat[c]=(byCat[c]||0)+rev;}\nconst lines=Object.entries(byCat).map(([k,v])=>`- ${k}: ${v.toLocaleString()}원`).join('\\n');\nreturn [{json:{요약:lines}}];"
      },
      "id": "t3c",
