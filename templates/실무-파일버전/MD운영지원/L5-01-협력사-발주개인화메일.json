{
 "name": "📮 협력사 발주 개인화 메일 · 파일버전",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "days",
       "triggerAtHour": 10,
       "triggerAtMinute": 0
      }
     ]
    }
   },
   "id": "s1a",
   "name": "매일 10:00",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    240,
    300
   ]
  },
  {
   "id": "read_발주현황",
   "name": "발주현황 파일 읽기",
   "type": "n8n-nodes-base.readWriteFile",
   "typeVersion": 1,
   "position": [
    440,
    300
   ],
   "parameters": {
    "fileSelector": "YOUR_DATA_DIR/발주현황.csv",
    "options": {}
   }
  },
  {
   "id": "ext_발주현황",
   "name": "발주현황 읽기",
   "type": "n8n-nodes-base.extractFromFile",
   "typeVersion": 1,
   "position": [
    640,
    300
   ],
   "parameters": {
        "operation": "csv",
        "options": {
          "enableBOM": true
        }
   }
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose"
     },
     "combinator": "and",
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ Number($json['발주필요수량']) }}",
       "rightValue": "0",
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ]
    },
    "options": {}
   },
   "id": "s1c",
   "name": "발주 필요만",
   "type": "n8n-nodes-base.filter",
   "typeVersion": 2.2,
   "position": [
    840,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      },
      {
       "name": "content-type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 500, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: '홈쇼핑 MD가 협력사에 보내는 발주 확인 메일 본문을 정중한 한국어로 작성해줘(3~5문장, 인사+발주내역+회신요청). 서명은 넣지 마.\\n협력사: ' + $('발주 필요만').item.json['협력사명'] + ' / 담당자: ' + $('발주 필요만').item.json['담당자'] + ' / 상품: ' + $('발주 필요만').item.json['상품명'] + ' / 발주필요수량: ' + $('발주 필요만').item.json['발주필요수량'] }] }) }}",
    "options": {}
   },
   "id": "s1d",
   "name": "Claude 발주메일 작성",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "sendTo": "={{ $('발주 필요만').item.json['담당자메일'] }}",
    "subject": "=[발주 확인] {{ $('발주 필요만').item.json['상품명'] }} {{ $('발주 필요만').item.json['발주필요수량'] }}개",
    "emailType": "text",
    "message": "={{ $json.content[0].text }}",
    "options": {}
   },
   "id": "s1e",
   "name": "협력사 발송",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1240,
    300
   ]
  }
