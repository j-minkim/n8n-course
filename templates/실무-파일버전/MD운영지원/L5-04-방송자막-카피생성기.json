    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 900, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: '홈쇼핑 방송/상세페이지 카피라이터다. 아래 상품 정보로 (1) 방송 자막 문구 3안(각 20자 내외, 자극적이지 않게) (2) 상세페이지 소개 문구 3문장 (3) 실시간 채팅 응대 멘트 2개 를 한국어로 만들어줘. 과장·허위·의료효능 표현 금지.\\n상품: ' + $json['상품명'] + ' / 핵심특징: ' + ($json['핵심특징']||'') + ' / 가격: ' + ($json['가격']||'') }] }) }}",
    "options": {}
   },
   "id": "s4c",
   "name": "Claude 카피 생성",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    840,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "return [{json:{상품명:$('카피 요청 읽기').item.json['상품명'], 생성카피:$json.content[0].text}}];"
   },
   "id": "s4d",
