{
 "name": "⏱ 생방송 실적 페이스메이커 · 파일버전",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "minutes",
       "minutesInterval": 5
      }
     ]
    }
   },
   "id": "b1a",
   "name": "방송 중 5분마다",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    240,
    300
   ]
  },
  {
   "id": "read_방송현황",
   "name": "방송현황 파일 읽기",
   "type": "n8n-nodes-base.readWriteFile",
   "typeVersion": 1,
   "position": [
    440,
    300
   ],
   "parameters": {
    "fileSelector": "YOUR_DATA_DIR/방송현황.csv",
    "options": {}
   }
  },
  {
   "id": "ext_방송현황",
   "name": "현재 방송실적 읽기",
   "type": "n8n-nodes-base.extractFromFile",
   "typeVersion": 1,
   "position": [
    640,
    300
   ],
   "parameters": {
        "operation": "csv",
        "options": {
          "enableBOM": true
        }
   }
  },
  {
   "parameters": {
    "jsCode": "const r=$json;\nconst num=v=>Number(String(v||0).replace(/[,\\s]/g,''))||0;\nconst 목표=num(r['목표매출']);\nconst 총분=num(r['총방송분'])||60;\nconst 경과=num(r['경과분']);\nconst 누적=num(r['누적매출']);\nconst 예상=총분>0?목표*(경과/총분):0;\nconst 달성률=예상>0?Math.round(누적/예상*100):100;\nreturn [{json:{상품명:r['상품명'],목표,누적,경과분:경과,달성률,저조:String(달성률<80)}}];"
   },
   "id": "b1c",
   "name": "목표 페이스 계산",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    840,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose"
     },
     "combinator": "and",
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json['저조'] }}",
       "rightValue": "true",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ]
    },
    "options": {}
   },
   "id": "b1d",
   "name": "저조할 때만",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      },
      {
       "name": "content-type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 350, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: '홈쇼핑 생방송이 목표 페이스보다 저조하다. 즉시 쓸 실시간 대응 2가지를 각 한 문장으로 제안해줘(예: 매진임박·수량한정 자막, 방송한정 추가 사은품 언급, 무이자 강조). 방송 진행자가 바로 읽을 수 있는 멘트로.\\n상품: ' + $json['상품명'] + ' / 현재 목표 대비 달성률: ' + $json['달성률'] + '% / 경과 ' + $json['경과분'] + '분' }] }) }}",
    "options": {}
   },
   "id": "b1e",
   "name": "Claude 실시간 대응멘트",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1240,
    220
   ]
  },
  {
   "parameters": {
    "sendTo": "YOUR_MDPD@example.com",
    "subject": "=[생방송] {{ $('목표 페이스 계산').item.json['상품명'] }} 목표 대비 {{ $('목표 페이스 계산').item.json['달성률'] }}% 저조",
    "emailType": "text",
    "message": "=⚠️ 생방송 실적 저조\n- 상품: {{ $('목표 페이스 계산').item.json['상품명'] }}\n- 목표 대비: {{ $('목표 페이스 계산').item.json['달성률'] }}% (경과 {{ $('목표 페이스 계산').item.json['경과분'] }}분)\n\n[실시간 대응 멘트]\n{{ $json.content[0].text }}",
    "options": {}
   },
   "id": "b1f",
   "name": "MD·PD 긴급 알림",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1440,
    220
   ]
  }
 ],
