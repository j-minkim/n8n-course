    "options": {}
   }
  },
  {
   "id": "ext_방송결과",
   "name": "방송결과 지표 읽기",
   "type": "n8n-nodes-base.extractFromFile",
   "typeVersion": 1,
   "position": [
    640,
    300
   ],
   "parameters": {
        "operation": "csv",
        "options": {
          "enableBOM": true
        }
   }
  },
  {
   "parameters": {
    "jsCode": "const r=$json;\nconst num=v=>Number(String(v||0).replace(/[,\\s]/g,''))||0;\nconst 목표=num(r['목표매출']),매출=num(r['매출']);\nconst 달성률=목표>0?Math.round(매출/목표*100):0;\nconst 주문=num(r['주문건수']),반품=num(r['반품건수']);\nconst 반품률=주문>0?Math.round(반품/주문*100):0;\nconst metrics=`방송: ${r['방송명']||'-'}\\n목표매출 ${목표.toLocaleString()} / 매출 ${매출.toLocaleString()} (달성률 ${달성률}%)\\n주문 ${주문}건 / 콜인입 ${r['콜인입']||'-'} / 콜포기율 ${r['콜포기율']||'-'} / 반품 ${반품}건(반품률 ${반품률}%)`;\nreturn [{json:{방송명:r['방송명'],달성률,metrics}}];"
   },
   "id": "b2c",
   "name": "지표 정리",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    840,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      },
      {
       "name": "content-type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 800, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: '다음은 오늘 홈쇼핑 방송 결과 지표다. MD가 팀에 공유할 방송 결과 리포트 초안을 아래 4개 소제목으로 한국어로 작성해줘: [요약] [잘된 점] [아쉬운 점] [다음 방송 개선안]. 사실 기반으로 간결하게.\\n' + $json['metrics'] }] }) }}",
    "options": {}
   },
   "id": "b2d",
   "name": "Claude 리포트 작성",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "sendTo": "YOUR_MD@example.com",
    "subject": "=[방송리포트] {{ $('지표 정리').item.json['방송명'] }} (달성률 {{ $('지표 정리').item.json['달성률'] }}%)",
    "emailType": "text",
    "message": "={{ $('지표 정리').item.json['metrics'] }}\n\n─────────────\n{{ $json.content[0].text }}",
    "options": {}
   },
   "id": "b2e",
   "name": "MD 리포트 초안",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1240,
    220
   ]
  },
  {
