   "typeVersion": 1,
   "position": [
    640,
    300
   ],
   "parameters": {
        "operation": "csv",
        "options": {
          "enableBOM": true
        }
   }
  },
  {
   "parameters": {
    "jsCode": "const items=$input.all();\nconst byProd={};\nfor(const it of items){const p=it.json['상품명']||'미상';(byProd[p]=byProd[p]||[]).push(String(it.json['반품사유']||''));}\nconst text=Object.entries(byProd).map(([k,v])=>`■ ${k} (${v.length}건)\\n`+v.map(x=>`- ${x}`).join('\\n')).join('\\n\\n');\nreturn [{json:{반품목록:text,건수:items.length}}];"
   },
   "id": "b3c",
   "name": "상품별 반품 묶기",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    840,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      },
      {
       "name": "content-type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 900, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: '다음은 상품별 반품 사유 목록이다. (1) 사유를 사이즈·품질·오배송·단순변심·기타로 분류해 상품별 건수를 집계하고, (2) 같은 상품에서 반복되는 이슈(3건 이상 등)를 콕 집어, (3) MD·협력사에 전달할 상품개선 제안을 한국어로 작성해줘.\\n' + $json['반품목록'] }] }) }}",
    "options": {}
   },
